# Discord Bot Token
# Get from: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# RailRadar API Key
# Get from: https://api.railradar.in/
RAILRADAR_API_KEY=your_railradar_api_key

# RailKit API Key  
# Get from: https://railkit-api.rajivdubey.dev/
RAILKIT_API_KEY=your_railkit_api_key

# IRCTC2 API Key (optional - for fallback)
# Get from: https://rapidapi.com/
IRCTC2_API_KEY=your_irctc2_api_key
